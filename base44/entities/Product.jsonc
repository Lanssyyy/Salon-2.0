{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "default": "General"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "reorder_level": {
      "type": "number",
      "default": 5
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "supplier": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}