{
  "name": "Setting",
  "type": "object",
  "properties": {
    "salon_name": {
      "type": "string",
      "default": "Luxe Salon"
    },
    "logo": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "$"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 0
    },
    "loyalty_enabled": {
      "type": "boolean",
      "default": true
    },
    "loyalty_rate": {
      "type": "number",
      "default": 1
    },
    "theme_color": {
      "type": "string",
      "default": "#b45309"
    }
  }
}