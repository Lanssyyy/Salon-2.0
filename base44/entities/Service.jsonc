{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Hair",
        "Nails",
        "Facial",
        "Massage",
        "Makeup",
        "Spa",
        "Waxing",
        "Lash & Brow"
      ],
      "default": "Hair"
    },
    "duration": {
      "type": "number",
      "default": 30
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "cost": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}